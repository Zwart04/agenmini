# Copy to .env for a new installation. Existing settings in data override these defaults.
WEB_PASSWORD=change-this-password
WEB_PORT=443
TZ=Asia/Jakarta
LLM_BACKEND=compatible
COMPATIBLE_BASE=http://router:20128/v1
COMPATIBLE_KEY=
MODEL=replace-with-model-or-combo-from-9router
TOOL_MODE=text
NUM_CTX=4096
CHROMIUM=0
# Built from this release's checksum-verified gateway binary.
NINE_ROUTER_IMAGE=agenmini-gateway:local

# Mandatory: generate with openssl rand -hex 32. Installer fills this automatically.
ROUTER_JWT_SECRET=

# Legacy FreeLLMAPI values retained only for existing installations.
FREELLMAPI_ENCRYPTION_KEY=
FREELLMAPI_ADMIN_PASSWORD=
